{
  "settings": {
    "number_of_shards": 3,
    "number_of_replicas": 1,
    "analysis": {
      "filter": {
        "portuguese_stemmer": { "type": "stemmer", "language": "portuguese" },
        "portuguese_stop":   { "type": "stop",    "language": "portuguese" },
        "pt_synonyms": {
          "type": "synonym",
          "synonyms": [
            "casa, casas, casarão, casinha",
            "show, concerto, apresentação"
          ]
        }
      },
      "analyzer": {
        "portuguese": {
          "type": "custom",
          "tokenizer": "standard",
          "filter": ["lowercase", "asciifolding", "portuguese_stop", "portuguese_stemmer", "pt_synonyms"]
        }
      }
    }
  },
  "mappings": {
    "properties": {
      "event_id":    { "type": "keyword" },
      "version":     { "type": "long" },
      "description": { "type": "text", "analyzer": "portuguese" },
      "artist":      { "type": "text", "analyzer": "portuguese" },
      "type":        { "type": "keyword" },
      "date":        { "type": "date" },
      "status":      { "type": "keyword" },
      "venue":       { "type": "text", "analyzer": "portuguese" },
      "city":        { "type": "keyword" },
      "price_min":   { "type": "scaled_float", "scaling_factor": 100 },
      "available":   { "type": "integer" }
    }
  }
}
